<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Contact Us | Cartivo Marketplace & Inventory</title>
    <%- include('partials/headcdns') %>
  </head>

  <body class="relative overflow-x-hidden selection:bg-amber-100 selection:text-amber-900">

    <!-- Ambient 3D Floating Clay Elements -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute -top-10 -left-12 w-32 h-24 sm:w-44 sm:h-32 clay-torus animate-float-slow opacity-80 rotate-12"></div>
      <div class="absolute top-24 right-12 w-8 h-8 rounded-full bg-amber-400/50 blur-[2px] animate-float-gentle"></div>
      <div class="absolute top-[45%] -left-16 w-36 h-36 clay-sphere-blue animate-float-drift opacity-75"></div>
      <div class="absolute top-[40%] -right-10 w-24 h-40 clay-pill-amber animate-float-slow opacity-80 rotate-45"></div>
    </div>

    <!-- Navigation Header (Identical on all pages) -->
    <div class="relative z-20">
      <%- include('partials/header') %>
    </div>

    <!-- Main Content -->
    <main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 sm:mt-10 pb-16">

      <!-- Page Heading Section -->
      <section class="p-6 sm:p-10 bg-white/80 backdrop-blur-md rounded-3xl border border-slate-200/80 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.03)] mb-10 text-center sm:text-left">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100/90 border border-slate-200/60 text-[11px] font-semibold text-slate-600 mb-3 tracking-wide uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            GET IN TOUCH
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-3">
            Let's start a <span class="text-slate-800">conversation.</span>
          </h1>
          <p class="text-slate-500 text-xs sm:text-sm leading-relaxed">
            Have questions about marketplace listings, stock inventory APIs, or enterprise partnerships? Our dedicated support team is here to assist you.
          </p>
        </div>
      </section>

      <!-- Quick Contact Info Cards Grid -->
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
        
        <!-- Card 1: Email -->
        <div class="bg-white/90 backdrop-blur-md p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col justify-between group hover:-translate-y-1 transition-all">
          <div class="w-11 h-11 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg mb-4 group-hover:scale-105 transition-transform">
            <i class="fa-solid fa-envelope"></i>
          </div>
          <div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">Email Us</span>
            <strong class="text-sm font-bold text-slate-900 block truncate">support@cartivo.local</strong>
            <small class="text-xs text-slate-500 mt-1 block">Response within 2 hours</small>
          </div>
        </div>

        <!-- Card 2: Phone -->
        <div class="bg-white/90 backdrop-blur-md p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col justify-between group hover:-translate-y-1 transition-all">
          <div class="w-11 h-11 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg mb-4 group-hover:scale-105 transition-transform">
            <i class="fa-solid fa-phone"></i>
          </div>
          <div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">Call Us</span>
            <strong class="text-sm font-bold text-slate-900 block">+1 (555) 234-5678</strong>
            <small class="text-xs text-slate-500 mt-1 block">Mon-Fri from 9am to 6pm</small>
          </div>
        </div>

        <!-- Card 3: Location -->
        <div class="bg-white/90 backdrop-blur-md p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col justify-between group hover:-translate-y-1 transition-all">
          <div class="w-11 h-11 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg mb-4 group-hover:scale-105 transition-transform">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">Headquarters</span>
            <strong class="text-sm font-bold text-slate-900 block truncate">100 Market St, Suite 400</strong>
            <small class="text-xs text-slate-500 mt-1 block">San Francisco, CA 94105</small>
          </div>
        </div>

        <!-- Card 4: Live Status -->
        <div class="bg-white/90 backdrop-blur-md p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col justify-between group hover:-translate-y-1 transition-all">
          <div class="w-11 h-11 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg mb-4 group-hover:scale-105 transition-transform">
            <i class="fa-solid fa-clock"></i>
          </div>
          <div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">Working Hours</span>
            <strong class="text-sm font-bold text-slate-900 block">Mon - Fri · 24/5 Support</strong>
            <small class="text-xs text-emerald-600 font-semibold mt-1 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Support desk active
            </small>
          </div>
        </div>

      </section>

      <%- include('partials/contact-section') %>

      <!-- ==========================================
           SOCIAL MEDIA PROFILES SECTION
      =========================================== -->
      <section class="mb-12">
        <div class="bg-white/80 backdrop-blur-md rounded-3xl border border-slate-200/80 p-8 sm:p-10 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.03)]">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
              <span class="text-xs font-bold tracking-wider text-amber-500 uppercase">Connect With Us</span>
              <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight mt-1">
                Follow Cartivo on Social Media
              </h2>
            </div>
            <p class="text-xs text-slate-400 max-w-sm">
              Stay up-to-date with new product releases, feature updates, and inventory management tips.
            </p>
          </div>

          <!-- Social Media Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

            <!-- Twitter / X -->
            <a 
              href="https://twitter.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center gap-4 p-4 rounded-2xl bg-slate-50/80 hover:bg-white border border-slate-200/80 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all group"
            >
              <div class="w-12 h-12 rounded-2xl bg-slate-900 text-white flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-105 transition-transform">
                <i class="fa-brands fa-x-twitter"></i>
              </div>
              <div class="flex-grow">
                <strong class="text-xs font-bold text-slate-900 block group-hover:text-blue-600 transition-colors">Twitter / X</strong>
                <span class="text-[11px] text-slate-400">@CartivoMarket</span>
              </div>
              <span class="text-xs text-slate-400 group-hover:text-slate-900 transition-colors">↗</span>
            </a>

            <!-- GitHub -->
            <a 
              href="https://github.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center gap-4 p-4 rounded-2xl bg-slate-50/80 hover:bg-white border border-slate-200/80 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all group"
            >
              <div class="w-12 h-12 rounded-2xl bg-slate-800 text-white flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-105 transition-transform">
                <i class="fa-brands fa-github"></i>
              </div>
              <div class="flex-grow">
                <strong class="text-xs font-bold text-slate-900 block group-hover:text-blue-600 transition-colors">GitHub</strong>
                <span class="text-[11px] text-slate-400">cartivo-platform</span>
              </div>
              <span class="text-xs text-slate-400 group-hover:text-slate-900 transition-colors">↗</span>
            </a>

            <!-- LinkedIn -->
            <a 
              href="https://linkedin.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center gap-4 p-4 rounded-2xl bg-slate-50/80 hover:bg-white border border-slate-200/80 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all group"
            >
              <div class="w-12 h-12 rounded-2xl bg-[#0A66C2] text-white flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-105 transition-transform">
                <i class="fa-brands fa-linkedin-in"></i>
              </div>
              <div class="flex-grow">
                <strong class="text-xs font-bold text-slate-900 block group-hover:text-blue-600 transition-colors">LinkedIn</strong>
                <span class="text-[11px] text-slate-400">Cartivo Technologies</span>
              </div>
              <span class="text-xs text-slate-400 group-hover:text-slate-900 transition-colors">↗</span>
            </a>

            <!-- Instagram -->
            <a 
              href="https://instagram.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center gap-4 p-4 rounded-2xl bg-slate-50/80 hover:bg-white border border-slate-200/80 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all group"
            >
              <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-[#FD1D1D] to-[#833AB4] text-white flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-105 transition-transform">
                <i class="fa-brands fa-instagram"></i>
              </div>
              <div class="flex-grow">
                <strong class="text-xs font-bold text-slate-900 block group-hover:text-blue-600 transition-colors">Instagram</strong>
                <span class="text-[11px] text-slate-400">@cartivo.store</span>
              </div>
              <span class="text-xs text-slate-400 group-hover:text-slate-900 transition-colors">↗</span>
            </a>

            <!-- Discord -->
            <a 
              href="https://discord.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center gap-4 p-4 rounded-2xl bg-slate-50/80 hover:bg-white border border-slate-200/80 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all group"
            >
              <div class="w-12 h-12 rounded-2xl bg-[#5865F2] text-white flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-105 transition-transform">
                <i class="fa-brands fa-discord"></i>
              </div>
              <div class="flex-grow">
                <strong class="text-xs font-bold text-slate-900 block group-hover:text-blue-600 transition-colors">Discord</strong>
                <span class="text-[11px] text-slate-400">Cartivo Community</span>
              </div>
              <span class="text-xs text-slate-400 group-hover:text-slate-900 transition-colors">↗</span>
            </a>

            <!-- YouTube -->
            <a 
              href="https://youtube.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center gap-4 p-4 rounded-2xl bg-slate-50/80 hover:bg-white border border-slate-200/80 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all group"
            >
              <div class="w-12 h-12 rounded-2xl bg-[#FF0000] text-white flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-105 transition-transform">
                <i class="fa-brands fa-youtube"></i>
              </div>
              <div class="flex-grow">
                <strong class="text-xs font-bold text-slate-900 block group-hover:text-blue-600 transition-colors">YouTube</strong>
                <span class="text-[11px] text-slate-400">Cartivo Tutorials</span>
              </div>
              <span class="text-xs text-slate-400 group-hover:text-slate-900 transition-colors">↗</span>
            </a>

          </div>

        </div>
      </section>

      <!-- Bottom Playground Banner -->
      <%- include('partials/bottomBanner') %>

    </main>

    <!-- Footer (Identical on all pages) -->
    <%- include('partials/footer') %>
    <%- include('partials/footercdns') %>

  </body>
</html>

