<!DOCTYPE html>
<html lang="en">
<head>
    <title>Shop | Cartivo Collection</title>
    <%- include('partials/headcdns') %>
</head>

<body class="relative overflow-x-hidden selection:bg-amber-100 selection:text-amber-900">

    <!-- Ambient 3D Floating Clay Elements -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="absolute -top-10 -left-12 w-32 h-24 sm:w-44 sm:h-32 clay-torus animate-float-slow opacity-80 rotate-12"></div>
        <div class="absolute top-24 right-12 w-8 h-8 rounded-full bg-amber-400/50 blur-[2px] animate-float-gentle"></div>
        <div class="absolute top-[45%] -left-16 w-36 h-36 clay-sphere-blue animate-float-drift opacity-75"></div>
        <div class="absolute top-[40%] -right-10 w-24 h-40 clay-pill-amber animate-float-slow opacity-80 rotate-45"></div>
    </div>

    <!-- Navigation Header (Identical on all pages) -->
    <div class="relative z-20">
        <%- include('partials/header') %>
    </div>

    <!-- Main Content -->
    <main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 sm:mt-10 pb-16">

        <!-- Shop Heading & Cart Summary -->
        <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 p-6 sm:p-8 bg-white/80 backdrop-blur-md rounded-3xl border border-slate-200/80 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.03)] mb-8">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100/90 border border-slate-200/60 text-[11px] font-semibold text-slate-600 mb-3 tracking-wide uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                    CARTIVO COLLECTION
                </div>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                    Explore our <span class="text-slate-800">products.</span>
                </h1>
                <p class="text-slate-500 text-xs sm:text-sm mt-1">Discover quality verified products, all in one unified marketplace.</p>
            </div>

            <!-- Cart Summary Badge Pill -->
            <div class="flex items-center gap-3.5 bg-slate-50 px-5 py-3 rounded-full border border-slate-200/80 shadow-sm self-start sm:self-auto">
                <div class="w-10 h-10 rounded-full bg-slate-900 text-white flex items-center justify-center text-sm relative">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span id="cart-count" class="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-amber-500 text-white text-[10px] font-bold flex items-center justify-center ring-2 ring-white">0</span>
                </div>
                <div>
                    <strong class="text-xs font-bold text-slate-900 block">My Cart</strong>
                    <small id="cart-label" class="text-[11px] text-slate-500">0 items added</small>
                </div>
            </div>
        </section>

        <!-- Shop Toolbar: Count & Search -->
        <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <h2 class="text-lg font-bold text-slate-900">All Products</h2>
                <p class="text-xs text-slate-400"><%= products.length %> products available in inventory</p>
            </div>

            <div class="w-full sm:w-80 bg-white px-4 py-2.5 rounded-full border border-slate-200 shadow-sm flex items-center gap-3 focus-within:ring-2 focus-within:ring-slate-900/10 focus-within:border-slate-300 transition-all">
                <i class="fa-solid fa-magnifying-glass text-slate-400 text-xs"></i>
                <input 
                    type="search" 
                    id="shop-search"
                    placeholder="Search products..."
                    class="w-full text-xs text-slate-800 placeholder-slate-400 bg-transparent focus:outline-none"
                />
            </div>
        </section>

        <!-- Product Grid (4 Columns) -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="shop-grid">

            <% if (products.length > 0) { %>

                <% products.forEach(product => { %>

                    <article class="shop-product-card cartivo-card p-3 flex flex-col justify-between group">

                        <!-- Product Image & Quick View Trigger -->
                        <div class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 mb-3 flex items-center justify-center">

                            <% if (product.image) { %>
                                <img
                                    src="<%= product.image %>"
                                    alt="<%= product.name %>"
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                >
                            <% } else { %>
                                <div class="w-full h-full flex flex-col items-center justify-center text-slate-300 bg-slate-50">
                                    <i class="fa-solid fa-box-open text-3xl mb-1 text-slate-300"></i>
                                    <span class="text-[10px] font-semibold text-slate-400">No Image</span>
                                </div>
                            <% } %>

                            <!-- Category Badge -->
                            <span class="shop-category absolute top-2.5 left-2.5 px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase bg-white/90 backdrop-blur-md text-slate-700 rounded-lg shadow-sm">
                                <%= product.category || 'General' %>
                            </span>

                            <!-- Quick View Button -->
                            <button
                                type="button"
                                class="quick-view-btn absolute top-2.5 right-2.5 w-8 h-8 rounded-full bg-white/90 backdrop-blur-md text-slate-700 hover:text-slate-900 hover:bg-white flex items-center justify-center shadow-sm transition-all"
                                title="Quick View"
                                data-id="<%= product._id %>"
                                data-name="<%= product.name %>"
                                data-price="<%= product.price %>"
                                data-category="<%= product.category %>"
                                data-description="<%= product.description || '' %>"
                                data-image="<%= product.image %>"
                                data-stock="<%= product.stock %>"
                            >
                                <i class="fa-solid fa-eye text-xs"></i>
                            </button>

                        </div>

                        <!-- Product Info -->
                        <div class="shop-product-info px-1 flex flex-col flex-grow">

                            <h3 class="shop-product-name text-slate-900 font-bold text-sm leading-snug line-clamp-1 group-hover:text-blue-600 transition-colors">
                                <%= product.name %>
                            </h3>

                            <p class="shop-product-description text-xs text-slate-400 mt-1 mb-3 line-clamp-2 leading-relaxed">
                                <%= product.description || 'Verified product from Cartivo inventory.' %>
                            </p>

                            <!-- Price & Add to Cart -->
                            <div class="shop-product-bottom mt-auto pt-2.5 border-t border-slate-100 flex items-center justify-between">
                                <div class="shop-price">
                                    <span class="text-[10px] font-medium text-slate-400 block -mb-0.5">Price</span>
                                    <strong class="text-base font-extrabold text-slate-900">$<%= Number(product.price).toFixed(2) %></strong>
                                </div>

                                <button
                                    type="button"
                                    class="add-cart-btn px-3.5 py-1.5 rounded-full bg-slate-900 hover:bg-slate-800 disabled:bg-slate-300 text-white text-xs font-semibold shadow-sm transition-all inline-flex items-center gap-1.5"
                                    data-id="<%= product._id %>"
                                    data-name="<%= product.name %>"
                                    data-price="<%= product.price %>"
                                    data-image="<%= product.image || '' %>"
                                    <%= product.stock <= 0 ? 'disabled' : '' %>
                                >
                                    <i class="fa-solid fa-cart-plus text-[10px]"></i>
                                    <span><%= product.stock > 0 ? 'Add to Cart' : 'Sold Out' %></span>
                                </button>
                            </div>

                            <!-- Stock Status Indicator -->
                            <div class="mt-2.5 pt-2 flex items-center justify-between text-xs text-slate-400 border-t border-slate-50">
                                <span class="flex items-center gap-1.5 text-[11px]">
                                    <span class="w-1.5 h-1.5 rounded-full <%= product.stock > 0 ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
                                    <%= product.stock > 0 ? product.stock + ' in stock' : 'Out of Stock' %>
                                </span>
                                <a href="/product/<%= product._id %>/view" class="text-slate-600 font-semibold hover:text-blue-600 transition-colors text-[11px]">
                                    Details →
                                </a>
                            </div>

                        </div>

                    </article>

                <% }) %>

            <% } else { %>

                <div class="col-span-full p-12 text-center bg-white/80 backdrop-blur-md rounded-3xl border border-slate-200/80 shadow-sm">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-50 text-slate-400 flex items-center justify-center text-2xl mb-4">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <h3 class="text-base font-bold text-slate-800 mb-1">No products available</h3>
                    <p class="text-xs text-slate-500 max-w-sm mx-auto mb-6">New products will appear here when they are added to the inventory collection.</p>
                    <a href="/product/new" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-md transition-all">
                        <i class="fa-solid fa-plus text-[10px]"></i>
                        <span>Add New Product</span>
                    </a>
                </div>

            <% } %>

        </section>

    </main>

    <!-- Quick View Modal (Modern Light Theme) -->
    <div class="quick-view-modal" id="quick-view-modal">

        <div class="quick-view-overlay" id="quick-view-close"></div>

        <div class="quick-view-content relative bg-white rounded-3xl p-6 sm:p-8 max-w-2xl w-[92%] shadow-2xl border border-slate-200 z-50">

            <button type="button" class="modal-close absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors" id="modal-close">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>

            <div class="quick-view-layout grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">

                <div class="quick-view-image aspect-square rounded-2xl bg-slate-100 overflow-hidden flex items-center justify-center" id="quick-view-image">
                    <i class="fa-solid fa-box-open text-4xl text-slate-300"></i>
                </div>

                <div class="quick-view-details flex flex-col items-start">
                    <span class="text-[10px] font-bold tracking-wider text-amber-500 uppercase mb-1">Quick Preview</span>
                    <h2 id="quick-view-name" class="text-xl font-extrabold text-slate-900 mb-2 leading-tight"></h2>
                    <span class="category-badge inline-block px-2.5 py-1 text-[10px] font-bold uppercase rounded-lg bg-slate-100 text-slate-700 mb-3" id="quick-view-category"></span>
                    <h3 id="quick-view-price" class="text-2xl font-extrabold text-slate-900 mb-3"></h3>
                    <p id="quick-view-description" class="text-xs text-slate-500 leading-relaxed mb-4"></p>
                    <p class="quick-stock text-xs font-semibold text-emerald-600 mb-5 flex items-center gap-1.5" id="quick-view-stock"></p>

                    <button type="button" class="w-full sm:w-auto px-6 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-md transition-all inline-flex items-center justify-center gap-2" id="quick-add-cart">
                        <i class="fa-solid fa-cart-plus text-xs"></i>
                        <span>Add to Cart</span>
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Footer (Identical on all pages) -->
    <%- include('partials/footer') %>
    <%- include('partials/footercdns') %>
    
    <script src="/js/shop.js"></script>

</body>
</html>
