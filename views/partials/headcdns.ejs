<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Google Fonts: Plus Jakarta Sans & Inter -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>

<!-- FontAwesome 6 Icons -->
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
/>

<!-- Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          sans: ['"Plus Jakarta Sans"', 'Inter', 'sans-serif'],
        },
        colors: {
          brand: {
            50: '#F8FAFC',
            100: '#F1F5F9',
            200: '#E2E8F0',
            500: '#3B82F6',
            600: '#2563EB',
            dark: '#0F172A',
            charcoal: '#111827',
          },
          amber: {
            accent: '#F59E0B',
          }
        },
        boxShadow: {
          'soft-sm': '0 2px 8px -1px rgba(0, 0, 0, 0.04)',
          'soft': '0 8px 30px -4px rgba(0, 0, 0, 0.05), 0 4px 10px -2px rgba(0, 0, 0, 0.02)',
          'soft-hover': '0 20px 35px -6px rgba(0, 0, 0, 0.08), 0 10px 15px -3px rgba(0, 0, 0, 0.03)',
          'capsule': '0 12px 35px -5px rgba(0, 0, 0, 0.07)',
          'clay': 'inset 0 2px 4px 0 rgba(255, 255, 255, 0.6), 0 12px 30px -4px rgba(0, 0, 0, 0.06)',
        }
      }
    }
  }
</script>

<!-- Cartivo Modern Theme Stylesheet -->
<link rel="stylesheet" href="/css/cartivo-theme.css" />
