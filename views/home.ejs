<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Cartivo | Modern Marketplace & Inventory</title>
    <%- include('partials/headcdns') %>
  </head>

  <body class="relative overflow-x-hidden selection:bg-amber-100 selection:text-amber-900">

    <!-- Ambient 3D Floating Clay Elements (pure CSS gradients, zero image files) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <!-- Top-left peach clay torus -->
      <div class="absolute -top-10 -left-12 w-32 h-24 sm:w-44 sm:h-32 clay-torus animate-float-slow opacity-80 rotate-12"></div>
      
      <!-- Top-right ambient amber particle -->
      <div class="absolute top-20 right-12 w-8 h-8 rounded-full bg-amber-400/50 blur-[2px] animate-float-gentle"></div>

      <!-- Mid-left powder-blue clay sphere -->
      <div class="absolute top-[42%] -left-16 w-36 h-36 clay-sphere-blue animate-float-drift opacity-75"></div>

      <!-- Mid-right amber clay capsule -->
      <div class="absolute top-[38%] -right-10 w-24 h-40 clay-pill-amber animate-float-slow opacity-80 rotate-45"></div>

      <!-- Bottom-right large sculpted shape -->
      <div class="absolute bottom-16 -right-20 w-52 h-44 clay-torus animate-float-gentle opacity-70 -rotate-12"></div>
    </div>

    <!-- Navigation Header -->
    <div class="relative z-20">
      <%- include('partials/header') %>
    </div>

    <!-- Main Content Container -->
    <main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 sm:mt-10">

      <!-- ==========================================
           1. HERO SECTION
      =========================================== -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center pt-4 pb-12 sm:pb-16">
        
        <!-- Left Column: Copy & Search Capsule -->
        <div class="lg:col-span-6 flex flex-col items-start">
          
          <!-- Category Chip -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100/90 border border-slate-200/60 text-[11px] font-semibold text-slate-600 mb-5 tracking-wide uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            Classified Ads & Marketplace
          </div>

          <!-- Main Hero Headline -->
          <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-extrabold text-slate-900 tracking-tight leading-[1.12] mb-4">
            Discover, Trade &<br />
            <span class="text-slate-800">Manage Smarter.</span>
          </h1>

          <!-- Subtitle -->
          <p class="text-slate-500 text-sm sm:text-base leading-relaxed max-w-lg mb-8">
            Browse verified listings for designer furniture, modern electronics, luxury vehicles, and properties. Seamless inventory at your fingertips.
          </p>

          <!-- Dual-Segment Capsule Search Bar -->
          <form action="/shop" method="GET" class="w-full max-w-lg bg-white p-1.5 rounded-full shadow-[0_15px_40px_-10px_rgba(0,0,0,0.07)] border border-slate-200/80 flex items-center transition-all duration-300 focus-within:ring-2 focus-within:ring-slate-900/10 focus-within:border-slate-300">
            <!-- Keyword Input -->
            <div class="flex-1 px-4 flex items-center gap-2.5">
              <i class="fa-solid fa-magnifying-glass text-slate-400 text-xs sm:text-sm"></i>
              <input 
                type="text" 
                name="search" 
                placeholder="Search products, brands..." 
                class="w-full text-xs sm:text-sm text-slate-800 placeholder-slate-400 bg-transparent focus:outline-none"
              />
            </div>

            <!-- Divider -->
            <div class="h-6 w-[1px] bg-slate-200"></div>

            <!-- Category Selector -->
            <div class="px-2 sm:px-3">
              <select name="category" class="text-xs font-semibold text-slate-600 bg-transparent focus:outline-none cursor-pointer pr-1">
                <option value="">Categories</option>
                <option value="furniture">Furniture</option>
                <option value="electronics">Electronics</option>
                <option value="vehicles">Vehicles</option>
                <option value="properties">Properties</option>
                <option value="fashion">Fashion</option>
              </select>
            </div>

            <!-- Search Action Submit Button -->
            <button type="submit" class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-slate-900 hover:bg-slate-800 text-white flex items-center justify-center transition-transform hover:scale-105 shadow-md flex-shrink-0" title="Search">
              <i class="fa-solid fa-magnifying-glass text-xs"></i>
            </button>
          </form>

          <!-- Quick Action Buttons / Tags -->
          <div class="flex items-center gap-3 mt-5">
            <a href="/shop" class="px-5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-sm transition-all hover:-translate-y-0.5">
              Search now
            </a>
            <a href="#categories" class="px-5 py-2.5 rounded-full bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold border border-slate-200/80 shadow-sm transition-all">
              Categories
            </a>
          </div>

        </div>

        <!-- Right Column: Staged 3D Living Room Visual Scene -->
        <div class="lg:col-span-6 relative">
          <div class="relative mx-auto max-w-lg lg:max-w-none">
            
            <!-- Soft Ambient Backlight Glow -->
            <div class="absolute -inset-4 bg-gradient-to-tr from-blue-100/60 via-amber-100/40 to-slate-100/70 rounded-3xl blur-2xl -z-10"></div>

            <!-- 3D Perspective Card Container (using CDN staging image, zero local image files) -->
            <div class="relative rounded-3xl overflow-hidden bg-white/90 border border-white/80 shadow-[0_20px_50px_-15px_rgba(15,23,42,0.1)] group">
              <img 
                src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=1000&auto=format&fit=crop&q=80" 
                alt="Scandinavian Minimalist Interior" 
                class="w-full h-[320px] sm:h-[400px] object-cover object-center group-hover:scale-[1.02] transition-transform duration-700"
                loading="lazy"
              />

              <!-- Floating Glass Badge Overlay -->
              <div class="absolute bottom-4 left-4 right-4 sm:right-auto px-4 py-3 bg-white/90 backdrop-blur-md border border-white rounded-2xl shadow-lg flex items-center justify-between sm:justify-start gap-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm">
                    <i class="fa-solid fa-couch"></i>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold text-slate-900">Modern Scandinavian Living</h4>
                    <p class="text-[11px] text-slate-500">Curated Architecture Collection</p>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-xs font-extrabold text-slate-900 block">$350.00</span>
                  <div class="flex items-center text-amber-400 text-[10px] gap-0.5">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>

      </section>

      <!-- ==========================================
           2. FLOATING CATEGORIES BAR
      =========================================== -->
      <section id="categories" class="relative z-10 -mt-2 mb-16 scroll-mt-24">
        <div class="p-4 sm:p-5 bg-white/80 backdrop-blur-md rounded-3xl border border-slate-200/80 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.04)]">
          <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 sm:gap-4">
            
            <!-- Category 1: Home & Living -->
            <a href="/shop?category=furniture" class="group flex flex-col items-center justify-center p-3.5 sm:p-4 rounded-2xl bg-white border border-slate-100 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all">
              <div class="w-11 h-11 rounded-xl bg-slate-50 group-hover:bg-blue-50 text-slate-600 group-hover:text-blue-600 flex items-center justify-center text-base mb-2 transition-colors">
                <i class="fa-solid fa-couch"></i>
              </div>
              <span class="text-xs font-bold text-slate-800 group-hover:text-slate-900">Home</span>
              <span class="text-[10px] text-slate-400">Furniture</span>
            </a>

            <!-- Category 2: Properties -->
            <a href="/shop?category=properties" class="group flex flex-col items-center justify-center p-3.5 sm:p-4 rounded-2xl bg-white border border-slate-100 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all">
              <div class="w-11 h-11 rounded-xl bg-slate-50 group-hover:bg-amber-50 text-slate-600 group-hover:text-amber-600 flex items-center justify-center text-base mb-2 transition-colors">
                <i class="fa-solid fa-building"></i>
              </div>
              <span class="text-xs font-bold text-slate-800 group-hover:text-slate-900">Properties</span>
              <span class="text-[10px] text-slate-400">Real Estate</span>
            </a>

            <!-- Category 3: Electronics -->
            <a href="/shop?category=electronics" class="group flex flex-col items-center justify-center p-3.5 sm:p-4 rounded-2xl bg-white border border-slate-100 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all">
              <div class="w-11 h-11 rounded-xl bg-slate-50 group-hover:bg-purple-50 text-slate-600 group-hover:text-purple-600 flex items-center justify-center text-base mb-2 transition-colors">
                <i class="fa-solid fa-laptop"></i>
              </div>
              <span class="text-xs font-bold text-slate-800 group-hover:text-slate-900">Electronics</span>
              <span class="text-[10px] text-slate-400">Tech & Gadgets</span>
            </a>

            <!-- Category 4: Animals & Pets -->
            <a href="/shop?category=pets" class="group flex flex-col items-center justify-center p-3.5 sm:p-4 rounded-2xl bg-white border border-slate-100 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all">
              <div class="w-11 h-11 rounded-xl bg-slate-50 group-hover:bg-rose-50 text-slate-600 group-hover:text-rose-600 flex items-center justify-center text-base mb-2 transition-colors">
                <i class="fa-solid fa-heart"></i>
              </div>
              <span class="text-xs font-bold text-slate-800 group-hover:text-slate-900">Animals</span>
              <span class="text-[10px] text-slate-400">Pets & Care</span>
            </a>

            <!-- Category 5: Vehicles / Location -->
            <a href="/shop?category=vehicles" class="group flex flex-col items-center justify-center p-3.5 sm:p-4 rounded-2xl bg-white border border-slate-100 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all">
              <div class="w-11 h-11 rounded-xl bg-slate-50 group-hover:bg-emerald-50 text-slate-600 group-hover:text-emerald-600 flex items-center justify-center text-base mb-2 transition-colors">
                <i class="fa-solid fa-car"></i>
              </div>
              <span class="text-xs font-bold text-slate-800 group-hover:text-slate-900">Vehicles</span>
              <span class="text-[10px] text-slate-400">Cars & Motors</span>
            </a>

            <!-- Category 6: Fashion / Origin -->
            <a href="/shop?category=fashion" class="group flex flex-col items-center justify-center p-3.5 sm:p-4 rounded-2xl bg-white border border-slate-100 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all">
              <div class="w-11 h-11 rounded-xl bg-slate-50 group-hover:bg-cyan-50 text-slate-600 group-hover:text-cyan-600 flex items-center justify-center text-base mb-2 transition-colors">
                <i class="fa-solid fa-user-tie"></i>
              </div>
              <span class="text-xs font-bold text-slate-800 group-hover:text-slate-900">Fashion</span>
              <span class="text-[10px] text-slate-400">Style & Wear</span>
            </a>

            <!-- Category 7: Services -->
            <a href="/shop?category=services" class="group flex flex-col items-center justify-center p-3.5 sm:p-4 rounded-2xl bg-white border border-slate-100 hover:border-slate-300 hover:shadow-md hover:-translate-y-1 transition-all col-span-2 sm:col-span-1">
              <div class="w-11 h-11 rounded-xl bg-slate-50 group-hover:bg-indigo-50 text-slate-600 group-hover:text-indigo-600 flex items-center justify-center text-base mb-2 transition-colors">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
              </div>
              <span class="text-xs font-bold text-slate-800 group-hover:text-slate-900">Services</span>
              <span class="text-[10px] text-slate-400">Professional</span>
            </a>

          </div>
        </div>
      </section>

      <!-- ==========================================
           3. PRODUCTS FROM DATABASE (DYNAMIC GRID)
      =========================================== -->
      <section class="mb-20">
        
        <!-- Section Header with Filters -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-bold tracking-wider text-amber-500 uppercase">Live Inventory</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
              Featured Products
            </h2>
          </div>

          <!-- Action Links & Count -->
          <div class="flex items-center gap-3">
            <span class="text-xs font-medium text-slate-400">
              <%= typeof products !== 'undefined' && products ? products.length : 0 %> products available
            </span>
            <a href="/shop" class="px-4 py-2 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-sm transition-all hover:-translate-y-0.5">
              Browse Shop →
            </a>
          </div>
        </div>

        <!-- Dynamic 4-Column Product Grid from Database -->
        <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <% products.forEach(product => { %>
              <article class="cartivo-card p-3 flex flex-col justify-between group">
                
                <!-- Product Image & Badges -->
                <div class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 mb-3 flex items-center justify-center">
                  <% if (product.image) { %>
                    <img 
                      src="<%= product.image %>" 
                      alt="<%= product.name %>" 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  <% } else { %>
                    <div class="w-full h-full flex flex-col items-center justify-center text-slate-300 bg-slate-50">
                      <i class="fa-solid fa-box-open text-3xl mb-1 text-slate-300"></i>
                      <span class="text-[10px] font-semibold text-slate-400">No Image</span>
                    </div>
                  <% } %>

                  <!-- Category Tag -->
                  <% if (product.category) { %>
                    <span class="absolute top-2.5 left-2.5 px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase bg-white/90 backdrop-blur-md text-slate-700 rounded-lg shadow-sm">
                      <%= product.category %>
                    </span>
                  <% } %>

                  <!-- Stock Status Badge -->
                  <span class="absolute top-2.5 right-2.5 px-2 py-0.5 text-[10px] font-bold <%= product.stock > 0 ? 'bg-amber-500 text-white' : 'bg-slate-400 text-white' %> rounded-md shadow-sm">
                    <%= product.stock > 0 ? 'IN STOCK' : 'OUT OF STOCK' %>
                  </span>
                </div>

                <!-- Product Info -->
                <div class="px-1 flex flex-col flex-grow">
                  <h3 class="text-slate-900 font-bold text-sm leading-snug line-clamp-1 group-hover:text-blue-600 transition-colors">
                    <%= product.name %>
                  </h3>
                  
                  <p class="text-xs text-slate-400 mt-1 mb-3 flex items-center gap-1.5">
                    <i class="fa-solid fa-tag text-[10px] text-slate-300"></i>
                    <span><%= product.condition || 'Verified Stock' %></span>
                    <span class="text-slate-200">·</span>
                    <span><%= product.stock %> items</span>
                  </p>

                  <!-- Price & Stars -->
                  <div class="mt-auto pt-2.5 border-t border-slate-100 flex items-center justify-between">
                    <div>
                      <span class="text-base font-extrabold text-slate-900">
                        $<%= Number(product.price).toFixed(2) %>
                      </span>
                    </div>
                    <div class="flex items-center text-amber-400 text-xs gap-0.5">
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                    </div>
                  </div>
                </div>

                <!-- Card Footer / Actions -->
                <div class="mt-3 pt-2.5 flex items-center justify-between text-xs text-slate-400 border-t border-slate-50">
                  <span class="flex items-center gap-1 text-[11px]">
                    <span class="w-1.5 h-1.5 rounded-full <%= product.stock > 0 ? 'bg-emerald-500' : 'bg-slate-300' %>"></span>
                    <%= product.stock > 0 ? 'Available' : 'Out of Stock' %>
                  </span>
                  <a href="/product/<%= product._id %>/view" class="text-slate-700 font-semibold hover:text-blue-600 transition-colors flex items-center gap-1">
                    Details <i class="fa-solid fa-arrow-right text-[10px]"></i>
                  </a>
                </div>

              </article>
            <% }) %>
          </div>
        <% } else { %>
          <!-- Empty State (When no active products exist in database) -->
          <div class="p-12 text-center bg-white/80 backdrop-blur-md rounded-3xl border border-slate-200/80 shadow-sm">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-50 text-slate-400 flex items-center justify-center text-2xl mb-4">
              <i class="fa-solid fa-box-open"></i>
            </div>
            <h3 class="text-base font-bold text-slate-800 mb-1">No products in database yet</h3>
            <p class="text-xs text-slate-500 max-w-sm mx-auto mb-6">
              Products you add to the inventory will automatically appear here on the home page and in the shop.
            </p>
            <a href="/product/new" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-md transition-all hover:-translate-y-0.5">
              <i class="fa-solid fa-plus text-[10px]"></i>
              <span>Add New Product</span>
            </a>
          </div>
        <% } %>

      </section>

      <!-- ==========================================
           4. TRUST & PLATFORM HIGHLIGHTS
      =========================================== -->
      <section class="mb-20">
        <div class="bg-white/80 backdrop-blur-md rounded-3xl border border-slate-200/80 p-8 sm:p-12 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.03)]">
          
          <div class="max-w-2xl mx-auto text-center mb-10">
            <span class="text-xs font-bold tracking-wider text-amber-500 uppercase">Built For Clarity</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1">
              Everything in its right place.
            </h2>
            <p class="text-slate-500 text-sm mt-2">
              Cartivo combines modern classified marketplace reach with powerful inventory management.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-6 rounded-2xl bg-slate-50/70 border border-slate-100 flex flex-col items-start">
              <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm mb-4">
                <i class="fa-solid fa-boxes-stacked"></i>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-1">Organized inventory</h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                Keep your products, categories, stock levels, and specs structured in one unified database.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-slate-50/70 border border-slate-100 flex flex-col items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center font-bold text-sm mb-4">
                <i class="fa-solid fa-bolt"></i>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-1">Fast & Simple Workflow</h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                Add, update, search, and manage your products with our streamlined and intuitive interface.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-slate-50/70 border border-slate-100 flex flex-col items-start">
              <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-sm mb-4">
                <i class="fa-solid fa-chart-simple"></i>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-1">Real-time Stock Control</h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                Understand your live inventory with low-stock alerts, active status toggling, and clean metrics.
              </p>
            </div>
          </div>

        </div>
      </section>

      <!-- ==========================================
           5. CONTACT SECTION
      =========================================== -->
      <section class="mb-12 scroll-mt-24" id="contact">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-white/80 backdrop-blur-md rounded-3xl border border-slate-200/80 p-8 sm:p-12 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.03)]">
          
          <div class="lg:col-span-5">
            <span class="text-xs font-bold tracking-wider text-amber-500 uppercase">Let's Connect</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1 mb-3">
              Have something<br /><span>on your mind?</span>
            </h2>
            <p class="text-slate-500 text-sm leading-relaxed mb-6">
              Have a question about a listing, partnership, or custom inventory setup? Send us a message anytime.
            </p>

            <div class="flex items-center gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center text-sm">
                <i class="fa-solid fa-envelope"></i>
              </div>
              <div>
                <strong class="text-xs font-bold text-slate-900 block">Get in touch</strong>
                <small class="text-slate-500 text-[11px]">support@cartivo.local</small>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7">
            <form action="/contact" method="POST" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-name" class="block text-xs font-bold text-slate-700 mb-1.5">Your name *</label>
                  <input
                    type="text"
                    id="contact-name"
                    name="name"
                    placeholder="Enter your name"
                    required
                    class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400"
                  />
                </div>
                <div>
                  <label for="contact-email" class="block text-xs font-bold text-slate-700 mb-1.5">Email address *</label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    placeholder="name@example.com"
                    required
                    class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400"
                  />
                </div>
              </div>

              <div>
                <label for="contact-subject" class="block text-xs font-bold text-slate-700 mb-1.5">Subject</label>
                <input
                  type="text"
                  id="contact-subject"
                  name="subject"
                  placeholder="How can we help?"
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400"
                />
              </div>

              <div>
                <label for="contact-message" class="block text-xs font-bold text-slate-700 mb-1.5">Your message *</label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="4"
                  placeholder="Write your message here..."
                  required
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 resize-none"
                ></textarea>
              </div>

              <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow-md hover:-translate-y-0.5 transition-all">
                <span>Send message</span>
                <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </button>
            </form>
          </div>

        </div>
      </section>

    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>
    <%- include('partials/footercdns') %>

  </body>
</html>
