<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Add Product | Cartivo</title>

    <%- include('partials/headcdns') %>
  </head>

  <body>
    <%- include('partials/header') %>

    <main class="form-page">
      <!-- Page Heading -->
      <div class="form-page-heading">
        <div>
          <span class="eyebrow">INVENTORY / ADD NEW</span>
          <h1>Add a new product.</h1>
          <p>Fill in the details below to add a product to your collection.</p>
        </div>

        <a href="/products" class="outline-btn">← Back to products</a>
      </div>

      <form
        action="/create-product"
        method="POST"
        enctype="multipart/form-data"
      >
        <!-- Basic Information -->
        <section class="form-card">
          <div class="form-section-heading">
            <div>
              <h3>01. Basic information</h3>
              <p>Enter the basic details of your product.</p>
            </div>
            <span class="section-icon">✦</span>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label>Product name <span>*</span></label>
              <input
                type="text"
                name="name"
                placeholder="Enter product name"
                required
              />
            </div>

            <div class="form-group">
              <label>Description </label>
              <textarea
                name="description"
                placeholder="Enter product description"
              ></textarea>
            </div>

            <div class="form-group">
              <label>Product image</label>
              <input type="file" name="product_image" accept="image/*" />
              <small class="field-hint">Upload JPG, PNG or WEBP image.</small>
            </div>
          </div>
        </section>

        <!-- Pricing & Inventory -->
        <section class="form-card">
          <div class="form-section-heading">
            <div>
              <h3>02. Pricing & inventory</h3>
              <p>Manage product pricing and stock information.</p>
            </div>
            <span class="section-icon">＄</span>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label>Price <span>*</span></label>
              <input
                type="number"
                name="price"
                placeholder="Enter amount in number e.g: 50"
                min="1"
                step="0.01"
                required
              />
            </div>

            <div class="form-group">
              <label>Stock quantity</label>
              <input
                type="number"
                name="stock"
                placeholder="Enter quantity in number e.g: 12"
                min="0"
              />
            </div>
          </div>
        </section>

        <!-- Categories & Options -->
        <section class="form-card">
          <div class="form-section-heading">
            <div>
              <h3>03. Categories & options</h3>
              <p>Select product categories and available options.</p>
            </div>
            <span class="section-icon">◈</span>
          </div>

          <div class="form-grid">
            <!-- Dropdown -->
            <div class="form-group">
              <label>Category <span>*</span></label>
              <select name="category" required>
                <option value="" disabled>Select category</option>
                <option value="electronics">Electronics</option>
                <option value="workspace">Workspace</option>
                <option value="books">Books</option>
                <option value="lifestyle">Lifestyle</option>
                <option value="accessories">Accessories</option>
              </select>
            </div>

            <!-- Radio Buttons -->
            <div class="form-group full-width">
              <label>Product condition</label>

              <div class="choice-group">
                <label class="choice-item">
                  <input type="radio" name="condition" value="new" checked />
                  <span>New</span>
                </label>

                <label class="choice-item">
                  <input type="radio" name="condition" value="used" />
                  <span>Used</span>
                </label>

                <label class="choice-item">
                  <input type="radio" name="condition" value="refurbished" />
                  <span>Refurbished</span>
                </label>
              </div>
            </div>

            <!-- Checkboxes -->
            <div class="form-group full-width">
              <label>Product features</label>

              <div class="choice-group">
                <label class="choice-item">
                  <input type="checkbox" name="features" value="featured" />
                  <span>Featured product</span>
                </label>

                <label class="choice-item">
                  <input type="checkbox" name="features" value="popular" />
                  <span>Popular</span>
                </label>

                <label class="choice-item">
                  <input type="checkbox" name="features" value="on_sale" />
                  <span>On sale</span>
                </label>
              </div>
            </div>

            <!-- Status Dropdown -->
            <div class="form-group">
              <label>Product status</label>
              <select name="status">
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
                <option value="draft">Draft</option>
              </select>
            </div>
          </div>
        </section>

        <!-- Form Actions -->
        <div class="form-actions">
          <button type="reset" class="reset-form-btn">Reset form</button>

          <button type="submit" class="primary-btn">＋ Save product</button>
        </div>
      </form>
    </main>

    <!-- Playground Banner -->
    <%- include('partials/bottomBanner') %>

    <!-- Footer -->
    <%- include('partials/footer') %>
  </body>
</html>
