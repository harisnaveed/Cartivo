<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Home | Cartivo</title>
    <%- include('partials/headcdns') %>
  </head>

  <body>
    <!-- Header -->
    <div class="app-container"><%- include('partials/header') %></div>

    <main>
      <!-- ================= HERO SECTION ================= -->

      <section class="home-hero">
        <div class="hero-content">
          <span class="eyebrow">WELCOME TO Cartivo</span>

          <h1>
            Manage smarter.<br />
            <span>Grow with clarity.</span>
          </h1>

          <p>
            A simple and powerful inventory management experience. Organize your
            products, manage stock, and keep your business moving forward.
          </p>

          <div class="hero-actions">
            <a href="/products" class="primary-btn"> Explore products → </a>

            <a href="/product/new" class="secondary-btn"> ＋ Add a product </a>
          </div>

          <div class="hero-note">
            <span class="status-dot"></span>
            Your inventory, organized in one place.
          </div>
        </div>

        <!-- Dashboard Preview -->
        <div class="hero-visual">
          <div class="visual-glow"></div>

          <div class="dashboard-preview">
            <div class="preview-header">
              <div>
                <span class="preview-dot"></span>
                <span>Inventory overview</span>
              </div>
              <span class="preview-menu">•••</span>
            </div>

            <div class="preview-welcome">
              <span>YOUR WORKSPACE</span>
              <h3>Good things are<br />in stock.</h3>
            </div>

            <div class="preview-stats">
              <div class="preview-stat">
                <span>Total products</span>
                <strong>1,240</strong>
                <small>↗ Organized collection</small>
              </div>

              <div class="preview-stat">
                <span>Active products</span>
                <strong>1,180</strong>
                <small class="green-text">● Available</small>
              </div>
            </div>

            <div class="preview-list">
              <div class="preview-list-heading">
                <strong>Recent products</strong>
                <span>View all →</span>
              </div>

              <div class="preview-product">
                <span class="product-icon purple">M</span>
                <div>
                  <strong>Wireless mouse</strong>
                  <small>MOUSE-001</small>
                </div>
                <b>$39.95</b>
              </div>

              <div class="preview-product">
                <span class="product-icon green">K</span>
                <div>
                  <strong>Mechanical keyboard</strong>
                  <small>KEY-002</small>
                </div>
                <b>$59.00</b>
              </div>

              <div class="preview-product">
                <span class="product-icon orange">H</span>
                <div>
                  <strong>Headphones</strong>
                  <small>AUDIO-003</small>
                </div>
                <b>$89.00</b>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= TRUST SECTION ================= -->

      <section class="trust-section">
        <div class="trust-heading">
          <span class="eyebrow">BUILT FOR BETTER ORGANIZATION</span>
          <h2>Everything in its right place.</h2>
        </div>

        <div class="trust-grid">
          <div class="trust-card">
            <span class="trust-icon">◈</span>
            <h3>Organized inventory</h3>
            <p>
              Keep your products, categories, and information structured in one
              place.
            </p>
          </div>

          <div class="trust-card">
            <span class="trust-icon">↗</span>
            <h3>Easy management</h3>
            <p>
              Add, update, search, and manage your products with a simple
              workflow.
            </p>
          </div>

          <div class="trust-card">
            <span class="trust-icon">⌁</span>
            <h3>Clear insights</h3>
            <p>
              Understand your inventory with useful product and stock
              information.
            </p>
          </div>
        </div>
      </section>

      <!-- ================= ABOUT SECTION ================= -->

      <section class="about-section">
        <div class="about-visual">
          <div class="about-orb"></div>

          <div class="about-card">
            <div class="about-card-top">
              <span class="status-dot"></span>
              <span>SMART INVENTORY</span>
            </div>

            <div class="about-symbol">G.</div>

            <h3>A clearer way<br />to manage products.</h3>

            <div class="about-card-bottom">
              <span>Cartivo INVENTORY LAB</span>
              <span>EST. 2026</span>
            </div>
          </div>
        </div>

        <div class="about-content">
          <span class="eyebrow">ABOUT Cartivo INVENTORY</span>

          <h2>
            Less clutter.<br />
            <span>More control.</span>
          </h2>

          <p>
            Managing products shouldn't feel complicated. Cartivo is designed to
            make product management simple, organized, and enjoyable.
          </p>

          <p>
            From adding new products to tracking stock information, everything
            is designed around a clean and straightforward experience.
          </p>

          <div class="about-points">
            <div>
              <span>✓</span>
              Simple product management
            </div>

            <div>
              <span>✓</span>
              Organized product collections
            </div>

            <div>
              <span>✓</span>
              Easy inventory tracking
            </div>
          </div>

          <a href="/products" class="primary-btn"> Explore our inventory → </a>
        </div>
      </section>

      <!-- ================= CONTACT SECTION ================= -->

      <section class="contact-section" id="contact">
        <div class="contact-heading">
          <span class="eyebrow">LET'S CONNECT</span>

          <h2>Have something<br /><span>on your mind?</span></h2>

          <p>
            Have a question, suggestion, or idea? Send us a message. We'd love
            to hear from you.
          </p>

          <div class="contact-detail">
            <span class="contact-detail-icon">✉</span>
            <div>
              <strong>Get in touch</strong>
              <small>We're always happy to connect.</small>
            </div>
          </div>
        </div>

        <div class="contact-form-card">
          <form action="/contact" method="POST">
            <div class="form-grid">
              <div class="form-group">
                <label for="contact-name">Your name *</label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  placeholder="Enter your name"
                  required
                />
              </div>

              <div class="form-group">
                <label for="contact-email">Email address *</label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  placeholder="name@example.com"
                  required
                />
              </div>

              <div class="form-group full-width">
                <label for="contact-subject">Subject</label>
                <input
                  type="text"
                  id="contact-subject"
                  name="subject"
                  placeholder="How can we help?"
                />
              </div>

              <div class="form-group full-width">
                <label for="contact-message">Your message *</label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="5"
                  placeholder="Write your message here..."
                  required
                ></textarea>
              </div>
            </div>

            <button type="submit" class="primary-btn contact-submit">
              Send message →
            </button>
          </form>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <div class="app-container"><%- include('partials/footer') %></div>
    <%- include('partials/footercdns') %>
  </body>
</html>
