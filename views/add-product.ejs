<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Add Product | Cartivo Inventory</title>
    <%- include('partials/headcdns') %>
  </head>

  <body
    class="relative overflow-x-hidden selection:bg-amber-100 selection:text-amber-900"
  >
    <!-- Ambient 3D Floating Clay Elements -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div
        class="absolute -top-10 -left-12 w-32 h-24 sm:w-44 sm:h-32 clay-torus animate-float-slow opacity-80 rotate-12"
      ></div>
      <div
        class="absolute top-24 right-12 w-8 h-8 rounded-full bg-amber-400/50 blur-[2px] animate-float-gentle"
      ></div>
      <div
        class="absolute top-[45%] -left-16 w-36 h-36 clay-sphere-blue animate-float-drift opacity-75"
      ></div>
      <div
        class="absolute top-[40%] -right-10 w-24 h-40 clay-pill-amber animate-float-slow opacity-80 rotate-45"
      ></div>
    </div>

    <!-- Navigation Header (Identical on all pages) -->
    <div class="relative z-20"><%- include('partials/header') %></div>

    <!-- Main Content -->
    <main
      class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 sm:mt-10 pb-16"
    >
      <!-- Page Heading -->
      <section
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-6 sm:p-8 bg-white/80 backdrop-blur-md rounded-3xl border border-slate-200/80 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.03)] mb-8"
      >
        <div>
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100/90 border border-slate-200/60 text-[11px] font-semibold text-slate-600 mb-2 tracking-wide uppercase"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            INVENTORY / ADD NEW
          </div>
          <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
            Add a new product.
          </h1>
          <p class="text-slate-500 text-xs sm:text-sm mt-1">
            Fill in the product specifications to register it in your active
            database.
          </p>
        </div>

        <a
          href="/products"
          class="px-4 py-2 rounded-full bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold border border-slate-200/80 shadow-sm transition-all self-start sm:self-auto"
        >
          ← Back to inventory
        </a>
      </section>

      <!-- Form Container -->
      <form
        action="/create-product"
        method="POST"
        enctype="multipart/form-data"
        class="space-y-6"
      >
        <!-- 01. Basic Information -->
        <section
          class="bg-white/90 backdrop-blur-md rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm"
        >
          <div
            class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100"
          >
            <div>
              <h3 class="text-base font-bold text-slate-900">
                01. Basic Information
              </h3>
              <p class="text-xs text-slate-400">
                Primary naming, descriptions, and media assets.
              </p>
            </div>
            <span
              class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-xs font-bold"
              >✦</span
            >
          </div>

          <div class="space-y-5">
            <!-- Product Name -->
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5">
                Product Name <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                name="name"
                placeholder="e.g. Modern Scandinavian Velvet Armchair"
                required
                class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition-all"
              />
            </div>

            <!-- Description -->
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5"
                >Description</label
              >
              <textarea
                name="description"
                rows="3"
                placeholder="Describe key specs, materials, or features..."
                class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition-all resize-none"
              ></textarea>
            </div>

            <!-- Image Upload -->
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5"
                >Product Image</label
              >
              <div
                class="flex items-center gap-4 p-4 rounded-2xl bg-slate-50 border border-dashed border-slate-300"
              >
                <input
                  type="file"
                  name="product_image"
                  accept="image/*"
                  class="text-xs text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-slate-900 file:text-white hover:file:bg-slate-800 cursor-pointer"
                />
              </div>
              <small class="text-[11px] text-slate-400 mt-1 block"
                >Supports JPG, PNG, WEBP files.</small
              >
            </div>
          </div>
        </section>

        <!-- 02. Pricing & Inventory -->
        <section
          class="bg-white/90 backdrop-blur-md rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm"
        >
          <div
            class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100"
          >
            <div>
              <h3 class="text-base font-bold text-slate-900">
                02. Pricing & Inventory
              </h3>
              <p class="text-xs text-slate-400">
                Set commercial valuation and available stock counts.
              </p>
            </div>
            <span
              class="w-8 h-8 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center text-xs font-bold"
              >＄</span
            >
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Price -->
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5">
                Price (USD) <span class="text-rose-500">*</span>
              </label>
              <input
                type="number"
                name="price"
                placeholder="e.g. 149.99"
                min="0.01"
                step="0.01"
                required
                class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition-all"
              />
            </div>

            <!-- Stock -->
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5"
                >Stock Quantity</label
              >
              <input
                type="number"
                name="stock"
                placeholder="e.g. 25"
                min="0"
                class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition-all"
              />
            </div>
          </div>
        </section>

        <!-- 03. Categories & Options -->
        <section
          class="bg-white/90 backdrop-blur-md rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm"
        >
          <div
            class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100"
          >
            <div>
              <h3 class="text-base font-bold text-slate-900">
                03. Categories & Options
              </h3>
              <p class="text-xs text-slate-400">
                Marketplace classification and listing status.
              </p>
            </div>
            <span
              class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold"
              >◈</span
            >
          </div>

          <div class="space-y-5">
            <!-- Category Dropdown -->
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5">
                Category <span class="text-rose-500">*</span>
              </label>
              <select
                name="category"
                required
                class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition-all cursor-pointer"
              >
                <option value="" disabled selected>Select category</option>
                <option value="furniture">Furniture</option>
                <option value="electronics">Electronics</option>
                <option value="vehicles">Vehicles</option>
                <option value="properties">Properties</option>
                <option value="fashion">Fashion</option>
                <option value="services">Services</option>
                <option value="workspace">Workspace</option>
                <option value="books">Books</option>
              </select>
            </div>

            <!-- Product Condition (Radio Buttons) -->
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-2"
                >Product Condition</label
              >
              <div class="flex flex-wrap gap-3">
                <label
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 cursor-pointer hover:bg-slate-100 transition-colors"
                >
                  <input
                    type="radio"
                    name="condition"
                    value="new"
                    checked
                    class="text-slate-900 focus:ring-0"
                  />
                  <span>New Condition</span>
                </label>
                <label
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 cursor-pointer hover:bg-slate-100 transition-colors"
                >
                  <input
                    type="radio"
                    name="condition"
                    value="used"
                    class="text-slate-900 focus:ring-0"
                  />
                  <span>Used</span>
                </label>
                <label
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 cursor-pointer hover:bg-slate-100 transition-colors"
                >
                  <input
                    type="radio"
                    name="condition"
                    value="refurbished"
                    class="text-slate-900 focus:ring-0"
                  />
                  <span>Refurbished</span>
                </label>
              </div>
            </div>

            <!-- Features Checkboxes -->
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-2"
                >Listing Highlights</label
              >
              <div class="flex flex-wrap gap-3">
                <label
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 cursor-pointer hover:bg-slate-100 transition-colors"
                >
                  <input
                    type="checkbox"
                    name="features"
                    value="featured"
                    class="rounded text-slate-900 focus:ring-0"
                  />
                  <span>Featured Product</span>
                </label>
                <label
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 cursor-pointer hover:bg-slate-100 transition-colors"
                >
                  <input
                    type="checkbox"
                    name="features"
                    value="popular"
                    class="rounded text-slate-900 focus:ring-0"
                  />
                  <span>Popular</span>
                </label>
                <label
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 cursor-pointer hover:bg-slate-100 transition-colors"
                >
                  <input
                    type="checkbox"
                    name="features"
                    value="on_sale"
                    class="rounded text-slate-900 focus:ring-0"
                  />
                  <span>On Sale</span>
                </label>
              </div>
            </div>

            <!-- Status Dropdown -->
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5"
                >Product Status</label
              >
              <select
                name="status"
                class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition-all cursor-pointer"
              >
                <option value="active" selected>
                  Active (Live in Storefront)
                </option>
                <option value="inactive">Inactive (Hidden)</option>
              </select>
            </div>
          </div>
        </section>

        <!-- Form Actions -->
        <div class="flex items-center justify-end gap-3 pt-4">
          <button
            type="reset"
            class="px-5 py-2.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-semibold transition-colors"
          >
            Reset Form
          </button>

          <button
            type="submit"
            class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow-md transition-all hover:-translate-y-0.5"
          >
            <span>＋</span> Save Product
          </button>
        </div>
      </form>

      <!-- Playground Banner -->
      <%- include('partials/bottomBanner') %>
    </main>

    <!-- Footer (Identical on all pages) -->
    <%- include('partials/footer') %> <%- include('partials/footercdns') %>
  </body>
</html>
