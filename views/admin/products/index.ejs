<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Products | Cartivo Admin Portal</title>
    <%- include('../partials/headcdns') %>
  </head>

  <body class="admin-body selection:bg-amber-100 selection:text-amber-900">

    <div class="admin-shell">
      
      <!-- Admin Sidebar Navigation -->
      <%- include('../partials/sidebar', { currentPage: 'products' }) %>

      <!-- Main Layout Wrapper -->
      <div class="admin-main-wrapper">
        
        <!-- Admin Top Navigation Bar -->
        <%- include('../partials/header', { title: 'Manage Products' }) %>

        <!-- Content Canvas -->
        <main class="admin-content">

          <% 
            const productList = (typeof products !== 'undefined' && products.length > 0) ? products : [
              { _id: '1', name: 'iPhone 15 Pro', slug: 'iphone-15-pro', price: 999, stock: 15, condition: 'New', status: 'active', category_id: { name: 'Mobile Phones' }, image: '' },
              { _id: '2', name: 'MacBook Pro M4', slug: 'macbook-pro-m4', price: 1599, stock: 8, condition: 'New', status: 'active', category_id: { name: 'Computers' }, image: '' },
              { _id: '3', name: 'Sony WH-1000XM5', slug: 'sony-wh-1000xm5', price: 349, stock: 2, condition: 'New', status: 'active', category_id: { name: 'Accessories' }, image: '' },
              { _id: '4', name: 'PlayStation 5', slug: 'playstation-5', price: 499, stock: 10, condition: 'New', status: 'active', category_id: { name: 'Gaming' }, image: '' }
            ];

            const totalCount = productList.length;
            const activeCount = typeof activeProducts !== 'undefined' ? activeProducts : productList.filter(p => p.status === 'active').length;
            const lowStockCount = typeof lowStockProducts !== 'undefined' ? lowStockProducts : productList.filter(p => p.stock < 5).length;
          %>

          <!-- Page Heading & Quick Add -->
          <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-6 sm:p-8 bg-white/85 backdrop-blur-md rounded-3xl border border-slate-200/80 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.03)] mb-8">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100/90 border border-slate-200/60 text-[11px] font-semibold text-slate-600 mb-2 tracking-wide uppercase">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                CATALOG INVENTORY
              </div>
              <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                Product Catalog
              </h1>
              <p class="text-slate-500 text-xs sm:text-sm mt-1">
                Oversee stock availability, inspect pricing, upload images, and control listing status.
              </p>
            </div>

            <a
              href="/admin/products/create"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-md transition-all hover:-translate-y-0.5 self-start sm:self-auto"
            >
              <span>＋</span> Add Product
            </a>
          </section>

          <!-- KPI Metric Stats Cards -->
          <section class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
            
            <!-- Total Products -->
            <div class="admin-card p-6 flex flex-col justify-between">
              <div class="flex items-center justify-between text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
                <span>Total Products</span>
                <span class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-xs">
                  <i class="fa-solid fa-boxes-stacked"></i>
                </span>
              </div>
              <div class="text-3xl font-extrabold text-slate-900"><%= totalCount %></div>
              <p class="text-[11px] text-slate-400 mt-1">Total items in collection</p>
            </div>

            <!-- Active Products -->
            <div class="admin-card p-6 flex flex-col justify-between">
              <div class="flex items-center justify-between text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
                <span>Active Listings</span>
                <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs">
                  <i class="fa-solid fa-circle-check"></i>
                </span>
              </div>
              <div class="text-3xl font-extrabold text-emerald-600"><%= activeCount %></div>
              <p class="text-[11px] text-slate-400 mt-1">Live in customer storefront</p>
            </div>

            <!-- Low Stock Alert -->
            <div class="admin-card p-6 flex flex-col justify-between">
              <div class="flex items-center justify-between text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
                <span>Low Stock</span>
                <span class="w-8 h-8 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center text-xs">
                  <i class="fa-solid fa-triangle-exclamation"></i>
                </span>
              </div>
              <div class="text-3xl font-extrabold text-amber-500"><%= lowStockCount %></div>
              <p class="text-[11px] text-slate-400 mt-1">5 units or fewer remaining</p>
            </div>

          </section>

          <!-- Products Table Container Card -->
          <section class="admin-card overflow-hidden">
            
            <!-- Table Header Toolbar -->
            <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                  <span>Product Collection</span>
                  <span id="table-record-count" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                    <%= totalCount %> items
                  </span>
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">Filter, inspect, and modify products.</p>
              </div>

              <!-- Instant Table Search -->
              <div class="w-full sm:w-72 bg-white px-4 py-2 rounded-full border border-slate-200 shadow-xs flex items-center gap-2.5 focus-within:ring-2 focus-within:ring-slate-900/10 focus-within:border-slate-300 transition-all">
                <i class="fa-solid fa-magnifying-glass text-slate-400 text-xs"></i>
                <input
                  type="text"
                  id="admin-table-search"
                  placeholder="Search products..."
                  class="w-full text-xs text-slate-800 placeholder-slate-400 bg-transparent focus:outline-none"
                />
              </div>
            </div>

            <!-- Table Wrapper -->
            <div class="overflow-x-auto">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th class="pl-6 w-16">Preview</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th class="pr-6 text-right">Actions</th>
                  </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                  <% if (productList.length > 0) { %>
                    <% productList.forEach((product) => { %>
                      <tr class="transition-colors">
                        
                        <!-- Thumbnail -->
                        <td class="pl-6 py-3.5">
                          <div class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 overflow-hidden flex items-center justify-center shrink-0">
                            <% if (product.image) { %>
                              <img
                                src="<%= product.image %>"
                                alt="<%= product.name %>"
                                class="w-full h-full object-cover"
                              />
                            <% } else { %>
                              <i class="fa-solid fa-box-open text-slate-300 text-sm"></i>
                            <% } %>
                          </div>
                        </td>

                        <!-- Name & Condition -->
                        <td class="font-bold text-slate-900 max-w-[200px]">
                          <div class="truncate"><%= product.name %></div>
                          <span class="text-[10px] text-slate-400 font-semibold block capitalize">
                            <%= product.condition || 'New' %>
                          </span>
                        </td>

                        <!-- Price -->
                        <td class="font-extrabold text-slate-900">
                          $<%= Number(product.price).toFixed(2) %>
                        </td>

                        <!-- Category -->
                        <td>
                          <span class="inline-block px-2.5 py-0.5 rounded-lg text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-700">
                            <%= product.category_id?.name || 'Unassigned' %>
                          </span>
                        </td>

                        <!-- Stock Count & Warning -->
                        <td>
                          <span class="font-bold <%= product.stock < 5 ? 'text-amber-600 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200 text-xs' : 'text-slate-800' %>">
                            <%= product.stock %>
                          </span>
                          <% if (product.stock < 5) { %>
                            <span class="text-[10px] text-amber-500 font-semibold block">Low stock</span>
                          <% } %>
                        </td>

                        <!-- Status Badge -->
                        <td>
                          <span class="badge-status <%= product.status === 'active' ? 'badge-status-active' : 'badge-status-inactive' %>">
                            <span class="w-1.5 h-1.5 rounded-full <%= product.status === 'active' ? 'bg-emerald-500' : 'bg-slate-400' %>"></span>
                            <%= product.status %>
                          </span>
                        </td>

                        <!-- Actions -->
                        <td class="pr-6 text-right">
                          <div class="flex items-center justify-end gap-1.5">
                            
                            <!-- Storefront View Link -->
                            <a
                              href="/product/<%= product.slug %>/view"
                              target="_blank"
                              class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 flex items-center justify-center transition-colors"
                              title="View in Storefront"
                            >
                              <i class="fa-solid fa-eye text-xs"></i>
                            </a>

                            <!-- Edit Link -->
                            <a
                              href="/admin/products/<%= product._id %>/edit"
                              class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 flex items-center justify-center transition-colors"
                              title="Edit Product"
                            >
                              <i class="fa-solid fa-pen text-xs"></i>
                            </a>

                            <!-- Delete Form -->
                            <form
                              action="/admin/products/<%= product._id %>/delete"
                              method="POST"
                              data-confirm="Are you sure you want to delete <%= product.name %>?"
                              class="inline"
                            >
                              <button
                                type="submit"
                                class="w-8 h-8 rounded-full bg-rose-50 hover:bg-rose-100 text-rose-600 flex items-center justify-center transition-colors"
                                title="Delete Product"
                              >
                                <i class="fa-solid fa-trash text-xs"></i>
                              </button>
                            </form>

                          </div>
                        </td>

                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr class="empty-placeholder-row">
                      <td colspan="7" class="py-12 text-center text-slate-400">
                        <i class="fa-solid fa-box-open text-3xl mb-2 block"></i>
                        <span>No products found in inventory.</span>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <!-- Table Footer -->
            <div class="p-4 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
              <span><%= totalCount %> total records</span>
              <a href="/admin/products/create" class="text-xs font-semibold text-slate-800 hover:text-blue-600 transition-colors">
                ＋ Add New Product
              </a>
            </div>

          </section>

        </main>

        <!-- Admin Footer -->
        <%- include('../partials/footer') %>

      </div>

    </div>

    <!-- Admin Client Scripts -->
    <%- include('../partials/footercdns') %>

  </body>
</html>
