<!DOCTYPE html>
<html lang="en">
<head>
    <title>Shop | Cartivo Collection</title>
    <%- include('partials/headcdns') %>
</head>

<body class="relative overflow-x-hidden selection:bg-amber-100 selection:text-amber-900">

    <!-- Ambient 3D Floating Clay Elements -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="absolute -top-10 -left-12 w-32 h-24 sm:w-44 sm:h-32 clay-torus animate-float-slow opacity-80 rotate-12"></div>
        <div class="absolute top-24 right-12 w-8 h-8 rounded-full bg-amber-400/50 blur-[2px] animate-float-gentle"></div>
        <div class="absolute top-[45%] -left-16 w-36 h-36 clay-sphere-blue animate-float-drift opacity-75"></div>
        <div class="absolute top-[40%] -right-10 w-24 h-40 clay-pill-amber animate-float-slow opacity-80 rotate-45"></div>
    </div>

    <!-- Navigation Header (Identical on all pages) -->
    <div class="relative z-20">
        <%- include('partials/header') %>
    </div>

    <!-- Main Content -->
    <main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 sm:mt-10 pb-16">

        <!-- Shop Heading & Cart Summary -->
        <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 p-6 sm:p-8 bg-white/80 backdrop-blur-md rounded-3xl border border-slate-200/80 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.03)] mb-8">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100/90 border border-slate-200/60 text-[11px] font-semibold text-slate-600 mb-3 tracking-wide uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                    CARTIVO COLLECTION
                </div>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                    Explore our <span class="text-slate-800">products.</span>
                </h1>
                <p class="text-slate-500 text-xs sm:text-sm mt-1">Discover quality verified products, all in one unified marketplace.</p>
            </div>

            <!-- Cart Summary Badge Pill Link -->
            <a
                href="/cart"
                class="group flex items-center gap-3.5 bg-slate-50 hover:bg-slate-100/90 px-5 py-3 rounded-full border border-slate-200/80 hover:border-slate-300 shadow-sm transition-all duration-200 self-start sm:self-auto hover:-translate-y-0.5"
                title="View Shopping Cart"
            >
                <div class="w-10 h-10 rounded-full bg-slate-900 group-hover:bg-slate-800 text-white flex items-center justify-center text-sm relative transition-colors">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span id="cart-count" class="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-amber-500 text-white text-[10px] font-bold flex items-center justify-center ring-2 ring-white">0</span>
                </div>
                <div>
                    <strong class="text-xs font-bold text-slate-900 group-hover:text-amber-600 transition-colors block">My Cart</strong>
                    <small id="cart-label" class="text-[11px] text-slate-500">0 items added</small>
                </div>
                <i class="fa-solid fa-arrow-right text-[11px] text-slate-400 group-hover:text-slate-700 group-hover:translate-x-0.5 transition-all ml-1"></i>
            </a>
        </section>

        <!-- Shop Toolbar: Count & Search -->
        <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <h2 class="text-lg font-bold text-slate-900">All Products</h2>
                <p class="text-xs text-slate-400"><%= products.length %> products available in inventory</p>
            </div>

            <div class="w-full sm:w-80 bg-white px-4 py-2.5 rounded-full border border-slate-200 shadow-sm flex items-center gap-3 focus-within:ring-2 focus-within:ring-slate-900/10 focus-within:border-slate-300 transition-all">
                <i class="fa-solid fa-magnifying-glass text-slate-400 text-xs"></i>
                <input 
                    type="search" 
                    id="shop-search"
                    placeholder="Search products..."
                    class="w-full text-xs text-slate-800 placeholder-slate-400 bg-transparent focus:outline-none"
                />
            </div>
        </section>

        <!-- Product Grid (4 Columns) -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="shop-grid">

            <% if (products.length > 0) { %>

                <% products.forEach(product => { %>
                    <%- include('partials/product-card', { product }) %>
                <% }) %>

            <% } else { %>

                <div class="col-span-full p-12 text-center bg-white/80 backdrop-blur-md rounded-3xl border border-slate-200/80 shadow-sm">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-50 text-slate-400 flex items-center justify-center text-2xl mb-4">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <h3 class="text-base font-bold text-slate-800 mb-1">No products available</h3>
                    <p class="text-xs text-slate-500 max-w-sm mx-auto mb-6">New products will appear here when they are added to the inventory collection.</p>
                    <a href="/admin/products/create" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-md transition-all">
                        <i class="fa-solid fa-plus text-[10px]"></i>
                        <span>Add New Product</span>
                    </a>
                </div>

            <% } %>

        </section>

    </main>

    <!-- Quick View Modal -->
    <%- include('partials/quick-view-modal') %>

    <!-- Footer (Identical on all pages) -->
    <%- include('partials/footer') %>
    <%- include('partials/footercdns') %>
    
    <script src="/js/shop.js"></script>

</body>
</html>
