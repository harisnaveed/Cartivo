<!DOCTYPE html>
<html lang="en">
<head>
    <title>Shop | Cartivo</title>
    <%- include('partials/headcdns') %>
</head>

<body>

    <div class="app-container">
        <%- include('partials/header') %>
    </div>

    <main class="shop-page">

        <!-- Shop Heading -->
        <section class="shop-heading">
            <div>
                <span class="eyebrow">CARTIVO COLLECTION</span>
                <h1>Explore our <span>products.</span></h1>
                <p>Discover quality products, all in one place.</p>
            </div>

            <div class="shop-cart-summary">
                <div class="cart-icon">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span id="cart-count">0</span>
                </div>
                <div>
                    <strong>My Cart</strong>
                    <small id="cart-label">0 items added</small>
                </div>
            </div>
        </section>

        <!-- Shop Toolbar -->
        <section class="shop-toolbar">
            <div>
                <h3>All Products</h3>
                <p><%= products.length %> products available</p>
            </div>

            <div class="shop-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" id="shop-search"
                    placeholder="Search products...">
            </div>
        </section>

        <!-- Product Grid -->
        <section class="shop-grid" id="shop-grid">

            <% if (products.length > 0) { %>

                <% products.forEach(product => { %>

                    <article class="shop-product-card">

                        <div class="shop-product-image">

                            <% if (product.image) { %>
                                <img
                                    src="<%= product.image %>"
                                    alt="<%= product.name %>"
                                >
                            <% } else { %>
                                <div class="shop-image-placeholder">
                                    <i class="fa-solid fa-box-open"></i>
                                </div>
                            <% } %>

                            <span class="shop-category">
                                <%= product.category %>
                            </span>

                            <button
                                type="button"
                                class="quick-view-btn"
                                title="Quick View"
                                data-name="<%= product.name %>"
                                data-price="<%= product.price %>"
                                data-category="<%= product.category %>"
                                data-description="<%= product.description || '' %>"
                                data-image="<%= product.image %>"
                                data-stock="<%= product.stock %>"
                            >
                                <i class="fa-solid fa-eye"></i>
                            </button>

                        </div>

                        <div class="shop-product-info">

                            <h3 class="shop-product-name">
                                <%= product.name %>
                            </h3>

                            <p class="shop-product-description">
                                <%= product.description || 'Explore this product from Cartivo.' %>
                            </p>

                            <div class="shop-product-bottom">

                                <div class="shop-price">
                                    <span>Price</span>
                                    <strong>$<%= Number(product.price).toFixed(2) %></strong>
                                </div>

                                <button
                                    type="button"
                                    class="add-cart-btn"
                                    data-id="<%= product._id %>"
                                    data-name="<%= product.name %>"
                                    data-price="<%= product.price %>"
                                    data-image="<%= product.image ? '/uploads/' + product.image : '' %>"
                                    <%= product.stock <= 0 ? 'disabled' : '' %>
                                >
                                    <i class="fa-solid fa-cart-plus"></i>
                                    <%= product.stock > 0 ? 'Add to Cart' : 'Out of Stock' %>
                                </button>

                            </div>

                            <div class="shop-stock">
                                <span class="<%= product.stock > 0 ? 'in-stock' : 'out-stock' %>">
                                    <i class="fa-solid fa-circle"></i>
                                    <%= product.stock > 0 ? 'In Stock' : 'Out of Stock' %>
                                </span>
                            </div>

                        </div>

                    </article>

                <% }) %>

            <% } else { %>

                <div class="shop-empty">
                    <i class="fa-solid fa-box-open"></i>
                    <h3>No products available</h3>
                    <p>New products will appear here when they are added.</p>
                </div>

            <% } %>

        </section>

    </main>

    <!-- Quick View Modal -->
    <div class="quick-view-modal" id="quick-view-modal">

        <div class="quick-view-overlay" id="quick-view-close"></div>

        <div class="quick-view-content">

            <button type="button" class="modal-close" id="modal-close">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="quick-view-layout">

                <div class="quick-view-image" id="quick-view-image">
                    <i class="fa-solid fa-box-open"></i>
                </div>

                <div class="quick-view-details">
                    <span class="eyebrow">PRODUCT DETAILS</span>
                    <h2 id="quick-view-name"></h2>
                    <span class="category-badge" id="quick-view-category"></span>
                    <h3 id="quick-view-price"></h3>
                    <p id="quick-view-description"></p>
                    <p class="quick-stock" id="quick-view-stock"></p>

                    <button type="button" class="primary-btn" id="quick-add-cart">
                        <i class="fa-solid fa-cart-plus"></i>
                        Add to Cart
                    </button>
                </div>

            </div>
        </div>
    </div>

    <div class="app-container">
        <%- include('partials/footer') %>
    </div>

    <%- include('partials/footercdns') %>
    <script src="/js/shop.js"></script>

</body>
</html>
