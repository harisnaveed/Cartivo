<header class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-5 pb-3">
  <nav class="relative flex items-center justify-between px-5 sm:px-7 py-3 bg-white/85 backdrop-blur-md border border-slate-100 rounded-full shadow-[0_8px_30px_-5px_rgba(0,0,0,0.04)] transition-all duration-300 z-50">
    
    <!-- Brand Logo -->
    <a href="/" class="brand flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-slate-900 to-slate-700 flex items-center justify-center text-white font-extrabold text-sm shadow-sm group-hover:scale-105 transition-transform">
        <span class="text-amber-400">C</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="font-extrabold text-lg sm:text-xl tracking-tight text-slate-900">Cartivo</span>
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
      </div>
    </a>

    <!-- Center Nav Links -->
    <div class="nav-links hidden md:flex items-center gap-1 bg-slate-50/80 px-2 py-1 rounded-full border border-slate-100">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 <%= currentPath === '/' ? 'bg-slate-900 text-white shadow-[0_2px_8px_rgba(15,23,42,0.15)]' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>"
      >
        <% if (currentPath === '/') { %><span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span><% } %>
        <span>Home</span>
      </a>
      <a
        href="/shop"
        class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 <%= (currentPath === '/shop' || currentPath.startsWith('/product/')) ? 'bg-slate-900 text-white shadow-[0_2px_8px_rgba(15,23,42,0.15)]' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>"
      >
        <% if (currentPath === '/shop' || currentPath.startsWith('/product/')) { %><span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span><% } %>
        <span>Shop</span>
      </a>
      <a
        href="/about"
        class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 <%= currentPath === '/about' ? 'bg-slate-900 text-white shadow-[0_2px_8px_rgba(15,23,42,0.15)]' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>"
      >
        <% if (currentPath === '/about') { %><span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span><% } %>
        <span>About</span>
      </a>
      <a
        href="/contact"
        class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 <%= currentPath === '/contact' ? 'bg-slate-900 text-white shadow-[0_2px_8px_rgba(15,23,42,0.15)]' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>"
      >
        <% if (currentPath === '/contact') { %><span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span><% } %>
        <span>Contact</span>
      </a>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-2.5">
      <!-- Cart Button with Dynamic Live Item Counter -->
      <a
        href="/cart"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border text-xs font-semibold transition-all duration-200 relative <%= currentPath === '/cart' ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-50 border-slate-200 bg-white' %>"
        title="View Shopping Cart"
      >
        <i class="fa-solid fa-bag-shopping text-xs <%= currentPath === '/cart' ? 'text-amber-400' : 'text-slate-600' %>"></i>
        <span class="hidden sm:inline">Cart</span>
        <span id="header-cart-count" class="min-w-4 h-4 px-1 rounded-full bg-amber-500 text-white text-[10px] font-bold flex items-center justify-center">0</span>
      </a>
    </div>
  </nav>
</header>
