<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= product.name %> | Cartivo Product Details</title>
    <%- include('partials/headcdns') %>
</head>

<body class="relative overflow-x-hidden selection:bg-amber-100 selection:text-amber-900">

    <!-- Ambient 3D Floating Clay Elements -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="absolute -top-10 -left-12 w-32 h-24 sm:w-44 sm:h-32 clay-torus animate-float-slow opacity-80 rotate-12"></div>
        <div class="absolute top-24 right-12 w-8 h-8 rounded-full bg-amber-400/50 blur-[2px] animate-float-gentle"></div>
        <div class="absolute top-[45%] -left-16 w-36 h-36 clay-sphere-blue animate-float-drift opacity-75"></div>
        <div class="absolute top-[40%] -right-10 w-24 h-40 clay-pill-amber animate-float-slow opacity-80 rotate-45"></div>
    </div>

    <!-- Navigation Header (Identical on all pages) -->
    <div class="relative z-20">
        <%- include('partials/header') %>
    </div>

    <!-- Main Content -->
    <main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 sm:mt-10 pb-16">

        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6">
            <a href="/" class="hover:text-slate-800 transition-colors">Home</a>
            <span>/</span>
            <a href="/products" class="hover:text-slate-800 transition-colors">Inventory</a>
            <span>/</span>
            <span class="text-slate-700 font-semibold truncate max-w-[200px] sm:max-w-none"><%= product.name %></span>
        </nav>

        <!-- Product Details 2-Column Showcase Layout -->
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start bg-white/85 backdrop-blur-md rounded-3xl border border-slate-200/80 p-6 sm:p-10 shadow-[0_15px_40px_-10px_rgba(15,23,42,0.04)] mb-12">

            <!-- Left: Product Image Showcase -->
            <div class="lg:col-span-5 relative">
                <div class="relative w-full aspect-square rounded-3xl overflow-hidden bg-slate-100 border border-slate-200/80 shadow-md flex items-center justify-center">
                    <% if (product.image) { %>
                        <img
                            src="<%= product.image %>"
                            alt="<%= product.name %>"
                            class="w-full h-full object-cover"
                        >
                    <% } else { %>
                        <div class="flex flex-col items-center justify-center text-slate-300">
                            <i class="fa-solid fa-box-open text-6xl mb-3 text-slate-300"></i>
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">No Image Uploaded</span>
                        </div>
                    <% } %>

                    <span class="absolute bottom-4 left-4 px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase bg-white/90 backdrop-blur-md text-slate-700 shadow-sm">
                        Verified Product
                    </span>
                </div>
            </div>

            <!-- Right: Product Information -->
            <div class="lg:col-span-7 flex flex-col items-start">
                
                <span class="text-[11px] font-bold tracking-wider text-amber-500 uppercase mb-2">PRODUCT SPECIFICATION</span>

                <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-3">
                    <%= product.name %>
                </h1>

                <!-- Badges -->
                <div class="flex flex-wrap items-center gap-2.5 mb-5">
                    <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-100 text-slate-700">
                        <%= product.category_id?.name || 'Not Found' %>
                    </span>

                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold capitalize <%= product.status === 'active' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-slate-100 text-slate-600' %>">
                        <span class="w-1.5 h-1.5 rounded-full <%= product.status === 'active' ? 'bg-emerald-500' : 'bg-slate-400' %>"></span>
                        <%= product.status %>
                    </span>

                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 capitalize">
                        Condition: <%= product.condition || 'New' %>
                    </span>
                </div>

                <!-- Price -->
                <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-5">
                    $<%= Number(product.price).toFixed(2) %>
                </div>

                <!-- Description -->
                <p class="text-sm text-slate-600 leading-relaxed mb-8 max-w-xl">
                    <%= product.description || "No product description provided." %>
                </p>

                <!-- Stock Cards Grid -->
                <div class="grid grid-cols-2 gap-4 w-full max-w-md mb-8">
                    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">AVAILABLE STOCK</span>
                        <strong class="text-2xl font-extrabold text-slate-900"><%= product.stock %></strong>
                        <span class="text-[11px] text-slate-400 block mt-0.5">Units in inventory</span>
                    </div>

                    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">STOCK STATUS</span>
                        <% if (product.stock < 5) { %>
                            <strong class="text-2xl font-extrabold text-amber-500">Low Stock</strong>
                            <span class="text-[11px] text-amber-600 block mt-0.5">Reorder recommended</span>
                        <% } else { %>
                            <strong class="text-2xl font-extrabold text-emerald-600">In Stock</strong>
                            <span class="text-[11px] text-emerald-600 block mt-0.5">Ready for fulfillment</span>
                        <% } %>
                    </div>
                </div>

                <!-- Metadata Timestamps -->
                <div class="flex items-center gap-6 text-xs text-slate-400 pb-6 mb-6 border-b border-slate-100 w-full">
                    <div>
                        <span class="block text-[10px] uppercase text-slate-400">Created</span>
                        <strong class="text-slate-700 font-semibold"><%= new Date(product.createdAt).toLocaleDateString() %></strong>
                    </div>
                    <div class="h-6 w-[1px] bg-slate-200"></div>
                    <div>
                        <span class="block text-[10px] uppercase text-slate-400">Last Updated</span>
                        <strong class="text-slate-700 font-semibold"><%= new Date(product.updatedAt).toLocaleDateString() %></strong>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex flex-wrap items-center gap-3">
                    <a href="/products" class="px-5 py-2.5 rounded-full bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold border border-slate-200/80 shadow-sm transition-all">
                        ← Back to Inventory
                    </a>

                    <a href="/shop" class="px-5 py-2.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold transition-all">
                        View in Shop
                    </a>

                    <button
                        type="button"
                        class="add-cart-btn px-6 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 disabled:bg-slate-300 text-white text-xs font-semibold shadow-md transition-all hover:-translate-y-0.5 inline-flex items-center gap-2"
                        data-id="<%= product._id %>"
                        data-name="<%= (product.name || '').replace(/"/g, '&quot;') %>"
                        data-price="<%= product.price %>"
                        data-image="<%= product.image || '' %>"
                        <%= product.stock <= 0 ? 'disabled' : '' %>
                    >
                        <i class="fa-solid fa-cart-plus text-xs"></i>
                        <span><%= product.stock > 0 ? 'Add to Cart' : 'Sold Out' %></span>
                    </button>
                </div>

            </div>

        </section>

        <!-- Playground Banner -->
        <%- include('partials/bottomBanner') %>

    </main>

    <!-- Footer (Identical on all pages) -->
    <%- include('partials/footer') %>
    <%- include('partials/footercdns') %>

</body>
</html>
